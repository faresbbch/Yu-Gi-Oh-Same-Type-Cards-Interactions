% ============================================================
%  config.sty — Academic journal style for data-analysis reports
%  Typography : EB Garamond + Bera Mono + microtype + GoudyIn
%  Layout     : single-column header, two-column body, single-column appendices
%  Ornaments  : pgfornament 88 (desaturated bordeaux, CMYK)
%  Reference  : joarvarndt.se/latex
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config}[2026/04/22 Data-Analysis Report Style v4]

% ── Encoding & language ────────────────────────────────────
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english]{babel}

% ── Typography ─────────────────────────────────────────────
\RequirePackage{ebgaramond}
\RequirePackage[scaled=0.85]{beramono}
\RequirePackage[
  kerning=true, tracking=true, spacing=true,
  factor=1500, stretch=50, selected=true
]{microtype}
\microtypecontext{spacing=nonfrench}
\DeclareMicrotypeSet*[expansion,spacing]{ebg-text}{encoding=T1}
\UseMicrotypeSet[expansion]{ebg-text}
\UseMicrotypeSet[spacing]{ebg-text}

% ── Page geometry & columns ────────────────────────────────
\RequirePackage[
  a4paper,
  top=2.0cm, bottom=1.5cm,
  left=2.0cm, right=1.5cm,
  columnsep=0.6cm,
  headheight=14pt, headsep=0.4cm
]{geometry}
\RequirePackage{multicol}
\RequirePackage{balance}
\setlength{\parskip}{3pt}
\setlength{\parindent}{1em}

% ── Colour palette ─────────────────────────────────────────
\RequirePackage[dvipsnames]{xcolor}
\definecolor{initcolor}{cmyk}{0.15, 0.90, 0.70, 0.30}
\definecolor{rulecolor}{gray}{0.25}

% ── Maths, tables, figures, lists ──────────────────────────
\RequirePackage{amsmath, amssymb}
\RequirePackage{booktabs, array, tabularx, multirow, float}
\setlength{\arrayrulewidth}{0.4pt}
\RequirePackage{graphicx}
\RequirePackage{subcaption}
\RequirePackage[hypcap=false]{caption}
\RequirePackage{capt-of}
\DeclareCaptionFormat{figformat}{\small\textit{#1#2}#3}
\DeclareCaptionFormat{tabformat}{\small\textsc{#1#2}#3\vspace{2pt}}
\captionsetup[figure]{format=figformat, labelsep=colon, name=Fig.,
  position=below, skip=4pt, justification=centering}
\captionsetup[table]{format=tabformat, labelsep=colon, name=Table,
  position=above, skip=4pt, justification=centering}
\captionsetup[subfigure]{font=small, labelfont=normalfont,
  labelformat=parens, skip=2pt}
\RequirePackage{enumitem}
\setlist{noitemsep, topsep=2pt, leftmargin=*}

% ── Headers & footers ──────────────────────────────────────
%  One fancy pagestyle. The left header reads a macro that the
%  user can switch globally. No fancypagestyle juggling, no
%  plain-override. Robust through any page break.
\RequirePackage{fancyhdr}

\newcommand{\@journalheader}{}
\newcommand{\journalheader}[1]{\gdef\@journalheader{#1}}    % global assignment
\newcommand{\@runningauthors}{}
\newcommand{\runningauthors}[1]{\gdef\@runningauthors{#1}}
\newcommand{\@studydate}{}
\newcommand{\studydate}[1]{\gdef\@studydate{#1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\footnotesize\textsc{\@journalheader}}
\fancyhead[R]{\footnotesize\textsc{\@runningauthors}}
\fancyfoot[C]{\footnotesize\thepage}
% Prevent \section from overwriting \leftmark and polluting the header:
\renewcommand{\sectionmark}[1]{}
\renewcommand{\subsectionmark}[1]{}

% ── Title page ─────────────────────────────────────────────
\RequirePackage{authblk}
\renewcommand{\Affilfont}{\small\itshape}
\renewcommand{\Authfont}{\normalsize}
\setlength{\affilsep}{0.2em}
\renewcommand{\maketitle}{%
  \begingroup
  \noindent\color{rulecolor}\rule{\textwidth}{0.8pt}\par\vspace{6pt}
  \begin{center}
    {\fontsize{16}{20}\selectfont\bfseries\@title\par}\vspace{6pt}
    {\normalsize\@author\par}
    \ifx\@studydate\empty\else\vspace{3pt}{\small\itshape\@studydate\par}\fi
  \end{center}\vspace{4pt}
  \noindent\color{rulecolor}\rule{\textwidth}{0.8pt}\par\vspace{10pt}
  \endgroup
}

% ── Abstract & keywords ────────────────────────────────────
\newenvironment{paperabstract}
  {\noindent\small\textbf{Abstract}\,---\,\ignorespaces}{\par\vspace{4pt}}
\newenvironment{keywords}
  {\noindent\small\textbf{Keywords}\,---\,\ignorespaces}{\par\vspace{4pt}}

% ── Body wrappers ──────────────────────────────────────────
\newcommand{\startbody}{%
  \noindent\color{rulecolor}\rule{\textwidth}{0.4pt}\par\vspace{2pt}
  \begin{multicols}{2}%
}
\newcommand{\stopbody}{\balance\end{multicols}}

% ── Section styling ────────────────────────────────────────
\RequirePackage{titlesec}
\renewcommand{\thesection}{\Roman{section}}
\titleformat{\section}
  {\normalsize\scshape\centering}{\thesection.\,}{0pt}{}
\titlespacing*{\section}{0pt}{1.2ex plus .3ex}{0.6ex}
\renewcommand{\thesubsection}{\Alph{subsection}}
\titleformat{\subsection}
  {\normalsize\itshape}{\thesubsection.\,}{0pt}{}
\titlespacing*{\subsection}{0pt}{0.8ex}{0.3ex}
\renewcommand{\thesubsubsection}{\alph{subsubsection}}
\titleformat{\subsubsection}
  {\small\itshape}{\thesubsubsection.\,}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{0.5ex}{0.2ex}

% ── Footnotes ──────────────────────────────────────────────
\RequirePackage{scrextend}
\deffootnote{0em}{1.6em}{\thefootnotemark.\enskip}

% ── Drop capital ───────────────────────────────────────────
\RequirePackage{lettrine}
\RequirePackage{GoudyIn}
\renewcommand{\LettrineFontHook}{\color{initcolor}\GoudyInfamily{}}
\setcounter{DefaultLines}{4}
\renewcommand{\DefaultLoversize}{0.1}

% ── End-of-body ornament ───────────────────────────────────
\RequirePackage{pgfornament}
\newcommand{\finalornament}{%
  \vspace{1.2em}%
  \begin{center}{\color{initcolor}\pgfornament[scale=0.4]{88}}\end{center}%
  \vspace{0.4em}%
}

% ── Hyperlinks ─────────────────────────────────────────────
\RequirePackage[
  colorlinks=true, linkcolor=black, citecolor=black,
  urlcolor=initcolor, bookmarks=false
]{hyperref}

% ── Bibliography ───────────────────────────────────────────
\RequirePackage[numbers, sort&compress]{natbib}
\bibliographystyle{plainnat}

% ============================================================
%  Utility commands
% ============================================================

\newcommand{\widefig}[4]{%
  \begin{figure*}[!htb]\centering
    \includegraphics[width=#2\textwidth]{#1}
    \caption{#3}\label{#4}
  \end{figure*}%
}

\newcommand{\doublefig}[6]{%
  \begin{figure*}[!htb]\centering
    \begin{subfigure}[b]{0.47\textwidth}\centering
      \includegraphics[width=\linewidth]{#1}\caption{#2}\end{subfigure}\hfill
    \begin{subfigure}[b]{0.47\textwidth}\centering
      \includegraphics[width=\linewidth]{#3}\caption{#4}\end{subfigure}
    \caption{#5}\label{#6}
  \end{figure*}%
}

\newcommand{\triplefig}[8]{%
  \begin{figure*}[!htb]\centering
    \begin{subfigure}[b]{0.31\textwidth}\centering
      \includegraphics[width=\linewidth]{#1}\caption{#2}\end{subfigure}\hfill
    \begin{subfigure}[b]{0.31\textwidth}\centering
      \includegraphics[width=\linewidth]{#3}\caption{#4}\end{subfigure}\hfill
    \begin{subfigure}[b]{0.31\textwidth}\centering
      \includegraphics[width=\linewidth]{#5}\caption{#6}\end{subfigure}
    \caption{#7}\label{#8}
  \end{figure*}%
}

\newcommand{\resulttable}[3]{%
  \par\vspace{4pt}%
  \begin{center}\small
    \captionof{table}{#1}\label{#2}\vspace{2pt}
    \begin{tabular}{lcc}\toprule
      \textbf{Predictor} & \textbf{Coef.} & \textbf{\textit{p}-value} \\\midrule
      #3\bottomrule
    \end{tabular}
  \end{center}%
  \par\vspace{4pt}%
}

\newcommand{\apptable}[4]{%
  \begin{center}\small
    \captionof{table}{#1}\label{#2}\vspace{2pt}
    \begin{tabular}{#3}\toprule #4\bottomrule\end{tabular}
  \end{center}%
}

% ── Appendices ─────────────────────────────────────────────
%  Switching the header is done by \gdef'ing \@journalheader
%  globally — the change persists across every page break,
%  including those triggered by [H] floats. No fancypagestyle,
%  no plain override, nothing clever.
\newenvironment{appendices}{%
  \clearpage
  \gdef\@journalheader{Appendix}%
  \setcounter{section}{0}%
  \renewcommand{\thesection}{\Alph{section}}%
  \renewcommand{\thesubsection}{\alph{subsection}}%
  \renewcommand{\theHsection}{App.\Alph{section}}%
  \renewcommand{\theHtable}{App.\arabic{table}}%
  \renewcommand{\theHfigure}{App.\arabic{figure}}%
  \setcounter{table}{0}%
  \renewcommand{\thetable}{A\arabic{table}}%
  \setcounter{figure}{0}%
  \renewcommand{\thefigure}{A\arabic{figure}}%
  \titleformat{\section}
    {\normalsize\scshape\centering}{Appendix~\thesection.\,}{0pt}{}%
}{}

\endinput